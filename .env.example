# Copia este archivo como .env y llena los valores. .env nunca se sube al repositorio.

# Base de datos de desarrollo y pruebas (local)
PGUSER=devwatch
PGPASSWORD=cambia-esta-contrasena-local
PGHOST=localhost

# Producción (F9)
DATABASE_URL=ecto://USUARIO:CONTRASENA@HOST/devwatch
SECRET_KEY_BASE=genera-con-mix-phx-gen-secret
PHX_HOST=devwatch.ejemplo.com

# Asistente (F8). Opcional: sin ella el asistente queda desactivado.
ANTHROPIC_API_KEY=

# Paquete de captura en la aplicación observada
DEVWATCH_KEY=
